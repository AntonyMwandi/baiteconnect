{
  "name": "baiteconnect",
  "version": "1.0.0",
  "description": "BaiteConnect — Digital Public Participation & Ward Budgeting Portal for Meru County, Kenya",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:generate": "prisma generate",
    "db:reset": "prisma migrate reset --force && npm run db:seed",
    "setup": "chmod +x scripts/setup.sh && ./scripts/setup.sh",
    "type-check": "tsc --noEmit",
    "seed:admins": "tsx scripts/seed-admin-users.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.10.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.5",
    "africastalking": "^0.6.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.0",
    "jose": "^5.2.3",
    "jsonwebtoken": "^9.0.2",
    "next": "^14.1.0",
    "next-pwa": "^5.6.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.12.0",
    "tailwind-merge": "^2.2.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "autoprefixer": "^10.4.17",
    "postcss": "^8.4.33",
    "prisma": "^5.10.2",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
// prisma/schema.prisma  (v2 — adds SubLocation, Village, Ward.isActive)

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [postgis, pgcrypto]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

enum UserRole { 
  CITIZEN 
  MCA 
  COUNTY_ADMIN 
  GOVERNOR_EXEC 
}
enum ModerationStatus { 
  PENDING 
  APPROVED 
  UNDER_REVIEW 
  SHADOW_BANNED 
}
enum ProjectStage { 
  ALLOCATED 
  TENDERED 
  ONGOING 
  COMPLETED 
}
enum ReportStatus { 
  UNDER_REVIEW 
  MYS_DISPATCHED 
  RESOLVED 
}

model User {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nationalId      String   @unique @db.VarChar(15)
  phoneNumber     String   @unique @db.VarChar(15)
  fullName        String   @db.VarChar(100)
  role            UserRole @default(CITIZEN)
  isPhoneVerified Boolean  @default(false)
  assignedWardId  Int?
  nationalIdHash  String   @unique @db.VarChar(64)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  memoranda        Memorandum[]
  whistleReports   WhistleblowerReport[]
  managedWards     Ward[]  @relation("WardMca")
  otpVerifications OtpVerification[]
  @@map("users")
}

model OtpVerification {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @db.Uuid
  phoneNumber String   @db.VarChar(15)
  otpCode     String   @db.VarChar(6)
  expiresAt   DateTime
  verified    Boolean  @default(false)
  attempts    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([phoneNumber, otpCode])
  @@map("otp_verifications")
}

model Ward {
  id          Int      @id @default(autoincrement())
  wardName    String   @db.VarChar(50)
  subCounty   String   @db.VarChar(50)
  mcaUserId   String?  @db.Uuid
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdBy   String?  @db.VarChar(100)
  mcaUser      User?        @relation("WardMca", fields: [mcaUserId], references: [id])
  memoranda    Memorandum[]
  projects     Project[]
  subLocations SubLocation[]
  @@index([subCounty])
  @@index([isActive])
  @@map("wards")
}

model SubLocation {
  id        Int      @id @default(autoincrement())
  wardId    Int
  name      String   @db.VarChar(100)
  latitude  Float?
  longitude Float?
  notes     String?  @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ward     Ward      @relation(fields: [wardId], references: [id], onDelete: Cascade)
  villages Village[]
  @@index([wardId])
  @@unique([wardId, name])
  @@map("sub_locations")
}

model Village {
  id            Int      @id @default(autoincrement())
  subLocationId Int
  name          String   @db.VarChar(100)
  latitude      Float?
  longitude     Float?
  estimatedPop  Int?
  notes         String?  @db.Text
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  subLocation SubLocation @relation(fields: [subLocationId], references: [id], onDelete: Cascade)
  @@index([subLocationId])
  @@unique([subLocationId, name])
  @@map("villages")
}

model FiscalYearBudget {
  id                  Int     @id @default(autoincrement())
  fiscalYear          String  @db.VarChar(10)
  sectorName          String  @db.VarChar(50)
  allocationBillions  Decimal @db.Decimal(5, 2)
  shillingsPerHundred Int
  isActive            Boolean @default(true)
  @@unique([fiscalYear, sectorName])
  @@map("fiscal_years_budget")
}

model Memorandum {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String           @db.Uuid
  wardId            Int
  fiscalYear        String           @db.VarChar(10)
  sectorCategory    String           @db.VarChar(50)
  writtenText       String           @db.Text
  attachmentUrl     String?          @db.VarChar(255)
  userSliderChoices Json             @db.JsonB
  submissionIp      String           @db.VarChar(45)
  submissionLat     Float
  submissionLng     Float
  isWithinWard      Boolean          @default(false)
  moderationStatus  ModerationStatus @default(PENDING)
  referenceCode     String           @unique @db.VarChar(20)
  createdAt         DateTime         @default(now()) @map("created_at")
  user User @relation(fields: [userId], references: [id])
  ward Ward @relation(fields: [wardId], references: [id])
  @@index([wardId, fiscalYear])
  @@index([moderationStatus])
  @@map("memoranda")
}

model Project {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wardId           Int
  title            String       @db.VarChar(150)
  description      String?      @db.Text
  allocatedBudget  Decimal      @db.Decimal(12, 2)
  currentStage     ProjectStage @default(TENDERED)
  contractorName   String?      @db.VarChar(100)
  mcaPriorityMatch Boolean      @default(false)
  latitude         Float?
  longitude        Float?
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at")
  ward           Ward                  @relation(fields: [wardId], references: [id])
  whistleReports WhistleblowerReport[]
  stageHistory   ProjectStageHistory[]
  @@map("projects")
}

model ProjectStageHistory {
  id        Int          @id @default(autoincrement())
  projectId String       @db.Uuid
  stage     ProjectStage
  notes     String?      @db.Text
  updatedBy String?      @db.VarChar(100)
  createdAt DateTime     @default(now()) @map("created_at")
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@map("project_stage_history")
}

model WhistleblowerReport {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId         String       @db.Uuid
  userId            String       @db.Uuid
  reportText        String       @db.Text
  photoEvidenceUrl  String       @db.VarChar(255)
  evidenceLat       Float
  evidenceLng       Float
  status            ReportStatus @default(UNDER_REVIEW)
  mysCohortAssigned String?      @db.VarChar(50)
  adminNotes        String?      @db.Text
  createdAt         DateTime     @default(now()) @map("created_at")
  project Project @relation(fields: [projectId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
  @@map("project_whistleblower_reports")
}

model McaProposal {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wardId        Int
  fiscalYear    String   @db.VarChar(10)
  title         String   @db.VarChar(150)
  description   String?  @db.Text
  sector        String   @db.VarChar(50)
  estimatedCost Decimal? @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @map("created_at")
  @@map("mca_proposals")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?  @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @db.VarChar(50)
  entityId   String   @db.VarChar(36)
  metadata   Json?    @db.JsonB
  ipAddress  String?  @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at")
  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

model RateLimitBucket {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier  String   @unique @db.VarChar(100)
  tokens      Int      @default(5)
  lastRefill  DateTime @default(now()) @map("last_refill")
  updatedAt   DateTime @updatedAt @map("updated_at")
  @@map("rate_limit_buckets")
}

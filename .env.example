# ─────────────────────────────────────────────────────────────
# BaiteConnect — baiteconnect.meru.go.ke
# Environment Configuration Template
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────

# ── Neon Serverless PostgreSQL ────────────────────────────────
# Pooled connection (used by Prisma in production via PgBouncer)
DATABASE_URL="postgresql://[user]:[password]@[project-id].neon.tech/[dbname]?sslmode=require&pgbouncer=true&connection_limit=1"

# Direct connection (used for Prisma Migrate — bypasses PgBouncer)
DIRECT_URL="postgresql://[user]:[password]@[project-id].neon.tech/[dbname]?sslmode=require"

# ── Security & Session ────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET="replace_with_64_char_hex_string_generated_via_openssl_rand_hex_32"

# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET="replace_with_64_char_hex_string_generated_via_openssl_rand_hex_32"

# ── Application ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://baiteconnect.meru.go.ke"
NEXT_PUBLIC_APP_NAME="BaiteConnect"
NEXT_PUBLIC_COUNTY="Meru County"
NEXT_PUBLIC_FISCAL_YEAR="2026/2027"

# ── Africa's Talking SMS Gateway ─────────────────────────────
AFRICAS_TALKING_USERNAME="sandbox"
AFRICAS_TALKING_API_KEY="atsk_your_production_api_key_here"
AFRICAS_TALKING_SMS_SENDER_ID="BAITECONN"

# ── File Storage (for memo attachments & whistleblower photos) ─
# Using Vercel Blob or Cloudflare R2. Format shown for Cloudflare R2.
STORAGE_ACCOUNT_ID="your_cloudflare_account_id"
STORAGE_ACCESS_KEY_ID="your_r2_access_key_id"
STORAGE_SECRET_ACCESS_KEY="your_r2_secret_access_key"
STORAGE_BUCKET_NAME="baiteconnect-uploads"
STORAGE_PUBLIC_URL="https://uploads.baiteconnect.meru.go.ke"

# ── Rate Limiting (Optional: Redis for production token buckets) ─
REDIS_URL="redis://default:[password]@[host]:6379"

# ── Admin Configuration ───────────────────────────────────────
ADMIN_INVITE_CODE="replace_with_secure_admin_invite_code"
GOVERNOR_DASHBOARD_PIN="replace_with_6_digit_pin"
